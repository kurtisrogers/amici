# Amici's configuration, in full. Copy to /etc/amici/amici.env.
#
#   sudo install -d -m 0700 /etc/amici
#   sudo install -m 0600 deploy/amici.env.example /etc/amici/amici.env
#
# Owned by root and mode 0600, because it contains the application secret and
# an SMTP password. internal/config refuses to start on several unsafe
# combinations of these, which is why there are so few comments here about
# what not to do: it will tell you.

# Production turns on secure cookies, refuses fixtures outright, requires a
# mail server and a secret, and switches the log to JSON.
AMICI_ENV=production

# Loopback only. TLS is terminated by Caddy in front of this; binding to a
# public interface would serve members plain HTTP and hand their session
# cookies to the network.
AMICI_ADDR=127.0.0.1:8080

# The absolute, public URL. This is what goes into confirmation and password
# reset links, so getting it wrong produces email nobody can act on. It must
# be https for those links to be safe to click.
AMICI_BASE_URL=https://amici.example

AMICI_DB=/var/lib/amici/amici.db

# Generate ONCE and keep it somewhere you will still have in two years:
#
#   openssl rand -base64 48
#
# It keys the HMAC over invite codes and recovery codes. There is no rotation
# mechanism yet, so changing this invalidates every outstanding request code
# and every unused recovery code at the same moment. Losing it is worse:
# nobody can redeem an invite or use a recovery code again.
AMICI_SECRET_KEY=replace-me-with-at-least-32-characters

# Required when anything sits in front of Amici, which in this arrangement it
# does. Without it every request appears to come from the proxy on 127.0.0.1,
# so every per-client rate limit — failed sign-ins, registrations, password
# reset requests — collapses into one shared bucket for the whole internet,
# and one determined stranger can spend everybody else's budget.
#
# It is off by default on purpose: believing X-Forwarded-For from a client
# that can set it freely is worse than not having it at all.
AMICI_TRUST_PROXY=true

# A transactional mail provider. Amici sends four kinds of message and all of
# them are things somebody is waiting for, so deliverability is not a
# nice-to-have: a password reset in a spam folder is a locked-out member.
# Set up SPF, DKIM and DMARC for the sending domain before inviting anybody.
AMICI_SMTP_ADDR=smtp.postmarkapp.com:587
AMICI_MAIL_FROM=hello@amici.example
AMICI_SMTP_USERNAME=replace-me
AMICI_SMTP_PASSWORD=replace-me
